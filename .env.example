# Neon Database Connection String (replace with your actual URL in .env.local)
DATABASE_URL="YOUR_DATABASE_URL_HERE"

# This is a placeholder URL. We will need to find the correct one.
PREMIER_LEAGUE_API_URL="https://fantasy.premierleague.com/api/leagues-classic/314/standings/"

# A private key for session encryption. Must be at least 32 characters long.
# You can generate a new one with: openssl rand -base64 32
SESSION_SECRET=

# A secret token to protect the cron job endpoint
# Can be any secure, random string
CRON_SECRET=
